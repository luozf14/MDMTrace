// Tune one scalar MDM dipole field for a given ion using legacy RAYTRACE.
{
    "mdmAngle"        : 0,
    "scatteredIon": {
        "massNumber"   : 12,
        "atomicNumber" : 6,
        "chargeState"  : 5
    },
    "scatteredEnergy" : 15,

    "fieldFinder": {
        "inputAngleXDeg"          : 0.0,
        "inputAngleYDeg"          : 0.0,
        "positionScaleCm"         : 0.1,
        "angleScaleDeg"           : 0.1,
        "searchHalfWidthFraction" : 0.25,
        "coarseSamples"           : 101,
        "fieldToleranceGauss"     : 0.001,
        "maxIterations"           : 1e3
    }
}
